# SAKALA Supabase Configuration
# Masukkan Project URL dan Anon Key dari dashboard Supabase Anda (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Biteship Logistics API Key
BITESHIP_API_KEY=biteship_test.your-biteship-api-key-here
